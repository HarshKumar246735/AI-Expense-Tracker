PORT=5000
NODE_ENV=development
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/expense-tracker?retryWrites=true&w=majority
CLIENT_URL=http://localhost:5173

# Long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
# lax works when frontend and API share a site (default / Vite proxy). Use "none" only with HTTPS cross-site hosting.
COOKIE_SAMESITE=lax

# Optional: without an AI key, built-in rule-based parsing and insights are used
AI_API_KEY=
AI_MODEL=claude-haiku-4-5-20251001
